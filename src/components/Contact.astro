---
import { locations } from '../data/locations';

const getMapUrl = (location: (typeof locations)[number]) =>
    'mapUrl' in location
        ? location.mapUrl
        : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.query)}`;
---

<section id="contact" class="bg-stone-100 py-16 text-stone-900 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6">
        <div class="fade-in mb-8 max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">
                Nasze lokalizacje
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
                Gdzie nas znajdziesz?
            </h2>
        </div>

        <div class="fade-in grid gap-4 sm:gap-6 lg:grid-cols-3">
            {
                locations.map((location) => (
                    <a
                        href={getMapUrl(location)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                            'group flex items-center gap-3 rounded-2xl border border-stone-200 p-4 shadow-sm transition-colors duration-200 sm:gap-4 sm:rounded-3xl sm:p-6',
                            'bg-white hover:bg-stone-50',
                            location.featured && 'lg:col-span-3 lg:mb-2',
                        ]}
                        aria-label={`Otwórz w Mapach Google: ${location.street}, ${location.city}`}
                    >
                        <span
                            class:list={[
                                'flex h-11 w-11 shrink-0 items-center justify-center rounded-full transition-colors duration-200',
                                'bg-stone-100 text-amber-700 group-hover:bg-amber-100',
                            ]}
                        >
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                class="h-5 w-5"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"
                                />
                                <circle cx="12" cy="10" r="2" />
                            </svg>
                        </span>

                        <div class="min-w-0 flex-1">
                            <p class="font-semibold text-stone-900">{location.name}</p>
                            <address class="mt-1 not-italic text-stone-600">
                                <span class="block">{location.street}</span>
                                <span class="block">{location.city}</span>
                            </address>
                        </div>

                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            class="h-5 w-5 shrink-0 text-stone-400 transition duration-200 group-hover:translate-x-1 group-hover:text-amber-700"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="m9 18 6-6-6-6"
                            />
                        </svg>
                    </a>
                ))
            }
        </div>

        <div class="fade-in mt-5 text-center text-base text-stone-600 sm:text-lg">
            <p class="leading-relaxed">
                Nasze produkty znajdziesz także w lokalnych sklepach. Zapytaj o ich dostępność!
            </p>
        </div>

        <div class="fade-in mt-10 border-t border-stone-300 pt-8">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">Kontakt</p>
            <div
                class="mt-4 flex flex-col gap-3 text-stone-600 sm:flex-row sm:items-center sm:gap-8"
            >
                <a
                    href="tel:+48503900284"
                    class="break-all font-semibold text-stone-900 transition hover:text-amber-700"
                >
                    +48 503 900 284
                </a>
                <span class="hidden h-6 w-px bg-stone-300 sm:block" aria-hidden="true"></span>
                <a
                    href="mailto:piekarnia.jedynka@gmail.com"
                    class="font-semibold text-stone-900 transition hover:text-amber-700"
                >
                    piekarnia.jedynka@gmail.com
                </a>
            </div>
        </div>
    </div>
</section>
