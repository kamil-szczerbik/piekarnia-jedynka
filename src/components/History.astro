---
import { chapters } from '../data/chapters';
import article from '../assets/images/history_article.jpg';

const portraitChapter = chapters.find((chapter) => chapter.layout === 'portrait');
const totalSteps = chapters.length + 1;
---

<!-- TŁA -->
<div class="fixed inset-0 bg-stone-950">
    {
        chapters.map((chapter, index) => (
            <div
                class="history-background absolute inset-0 opacity-0 transition-opacity duration-1000"
                data-background={index}
            >
                <img
                    src={chapter.image}
                    alt=""
                    class:list={[
                        'history-image h-full w-full',
                        chapter.layout === 'portrait'
                            ? 'scale-110 object-cover opacity-50 blur-xl'
                            : 'object-cover',
                    ]}
                />

                <div
                    class:list={[
                        'absolute inset-0',
                        chapter.layout === 'portrait'
                            ? 'bg-black/65'
                            : 'bg-black/55',
                    ]}
                />
            </div>
        ))
    }
</div>

<!-- GŁÓWNA NAKŁADKA -->
<div
    class="
        pointer-events-none
        fixed inset-0 z-50
        flex items-center justify-center
        px-6
        text-white
    "
>
    <!-- ZWYKŁE ROZDZIAŁY -->
    <div
        id="content"
        class="
            max-w-3xl
            text-center
            transition-all
            duration-700
        "
    >
        <p class="mb-3 text-xs uppercase tracking-[0.3em] text-amber-300 sm:mb-4 sm:text-sm">
            Piekarnia Jedynka
        </p>

        <h1
            id="title"
            class="text-4xl font-bold sm:text-6xl"
        >
        </h1>

        <p
            id="text"
            class="
                mx-auto mt-6 max-w-2xl
                text-base leading-relaxed
                text-white/90
                sm:text-xl
            "
        >
        </p>
    </div>

    <!-- ZAŁOŻYCIEL -->
    {
        portraitChapter && (
            <div
                id="portrait-content"
                class="
                    pointer-events-auto
                    absolute inset-0
                    hidden
                    items-center
                    overflow-y-auto
                    px-6
                    pb-32 pt-20
                    opacity-0
                    transition-all
                    duration-700
                    lg:px-12
                    xl:px-20
                "
            >
                <div
                    class="
                        mx-auto grid
                        w-full
                        max-w-7xl
                        items-center
                        gap-5
                        lg:grid-cols-[0.8fr_1.2fr]
                        lg:gap-16
                        xl:gap-24
                    "
                >
                    <!-- PORTRET -->
                    <div
                        class="
                            relative
                            mx-auto
                            flex
                            max-h-[26svh]
                            justify-center
                            lg:max-h-[78vh] lg:justify-end
                        "
                    >
                        <div
                            class="
                                absolute
                                -inset-8
                                rounded-[2rem]
                                bg-black/30
                                blur-3xl
                            "
                        />

                        <img
                            src={portraitChapter.image}
                            alt="Założyciel Piekarni Jedynka"
                            class="
                                relative
                                max-h-[26svh]
                                max-w-full
                                -rotate-[1.5deg]
                                object-contain
                                shadow-2xl
                                ring-1
                                ring-white/10
                                lg:max-h-[78vh]
                            "
                        />
                    </div>

                    <!-- TEKST -->
                    <div class="max-w-2xl">
                        <p
                            class="
                                mb-2
                                text-xs
                                uppercase
                                tracking-[0.3em]
                                text-amber-300
                            "
                        >
                            Początek historii
                        </p>

                        <h2
                            class="
                                text-2xl
                                font-bold
                                leading-tight
                                sm:text-4xl
                                lg:text-5xl
                            "
                        >
                            {portraitChapter.title}
                        </h2>

                        <div
                            class="
                                mt-4
                                space-y-3
                                text-sm
                                leading-relaxed
                                text-white/85
                                sm:mt-7 sm:space-y-4 sm:text-base
                                lg:text-lg
                            "
                        >
                            {
                                portraitChapter.text
                                    .split('\n\n')
                                    .map((paragraph) => (
                                        <p>{paragraph}</p>
                                    ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        )
    }

    <!-- ARTYKUŁ -->
    <div
        id="article-content"
        class="
            pointer-events-auto
            absolute inset-0
            hidden
            items-center
            justify-center
            overflow-y-auto
            px-6
            pb-32 pt-20
            opacity-0
            transition-all
            duration-700
            lg:px-16
        "
    >
        <div
            class="
                mx-auto grid
                max-w-7xl
                items-center
                gap-6
                lg:grid-cols-[0.8fr_1.2fr]
                lg:gap-20
            "
        >
            <div class="text-center lg:text-left">
                <p
                    class="
                        mb-2
                        text-xs uppercase
                        tracking-[0.3em]
                        text-amber-300
                    "
                >
                    Z kart historii
                </p>

                <h2 class="text-3xl font-bold sm:text-5xl">
                    Pisali o nas
                </h2>

                <p
                    class="
                        mt-3
                        max-w-xl
                        text-lg
                        leading-relaxed
                        text-white/85
                    "
                >
                    Fragment historii Piekarni Jedynka zachowany
                    na łamach lokalnej prasy.
                </p>
            </div>

            <a
                href={article.src}
                target="_blank"
                class="
                    pointer-events-auto
                    group
                    relative
                    mx-auto
                    block
                    max-h-[42svh]
                    max-w-2xl
                    cursor-zoom-in
                    transition
                    duration-500
                    hover:scale-[1.02]
                "
            >
                <div
                    class="
                        absolute
                        -inset-8
                        rounded-[2rem]
                        bg-black/30
                        blur-3xl
                    "
                />

                <img
                    src={article.src}
                    alt="Artykuł prasowy o Piekarni Jedynka"
                    class="
                        relative
                        max-h-[42svh]
                        w-auto
                        rotate-[1deg]
                        object-contain
                        shadow-2xl
                        ring-1
                        ring-white/10
                        transition-transform
                        duration-500
                        lg:max-h-[78vh]
                        group-hover:rotate-0
                    "
                />
            </a>
        </div>
    </div>

    <!-- POSTĘP HISTORII -->
    <nav
        class="pointer-events-auto absolute right-6 top-1/2 hidden -translate-y-1/2 sm:block lg:right-10"
        aria-label="Rozdziały historii"
    >
        <ol class="flex flex-col items-end gap-4">
            {
                Array.from({ length: totalSteps }, (_, index) => (
                    <li>
                        <button
                            type="button"
                            class="history-progress group flex cursor-pointer items-center gap-3 text-white/55 transition hover:text-white"
                            data-go-step={index}
                            aria-label={`Przejdź do etapu ${index + 1} z ${totalSteps}`}
                        >
                            <span class="history-progress-number text-xs font-semibold tabular-nums opacity-0 transition-opacity group-hover:opacity-100">
                                {String(index + 1).padStart(2, '0')}
                            </span>
                            <span class="history-progress-mark h-2 w-2 rounded-full bg-current transition-all duration-300" />
                        </button>
                    </li>
                ))
            }
        </ol>
    </nav>

    <p
        id="mobile-progress"
        class="absolute bottom-10 right-5 text-xs font-semibold tracking-[0.2em] text-white/70 sm:hidden"
        aria-live="polite"
    >
        01 / {String(totalSteps).padStart(2, '0')}
    </p>

    <!-- DALEJ -->
    <button
        id="next"
        class="
            pointer-events-auto
            absolute bottom-8 left-1/2
            flex -translate-x-1/2
            cursor-pointer
            flex-col items-center
            gap-2
            text-white/80
            transition
            hover:text-white
        "
    >
        <span
            id="next-label"
            class="text-sm uppercase tracking-widest"
        >
            Dalej
        </span>

        <span
            id="next-icon"
            class="text-2xl"
        >
            ↓
        </span>
    </button>

    <!-- POWRÓT -->
    <a
        href="/"
        class="
            pointer-events-auto
            absolute left-4 top-4
            flex items-center
            gap-2
            text-white/80
            transition
            hover:text-white
            sm:left-10 sm:top-10
        "
    >
        <span class="text-xl">←</span>

        <span class="text-xs uppercase tracking-widest sm:text-sm">
            Strona główna
        </span>
    </a>
</div>

<!-- SCROLL -->
<div class="relative z-10">
    {
        chapters.map((_, index) => (
            <div
                class="h-screen"
                data-step={index}
            />
        ))
    }

    <div
        class="h-screen"
        data-step={chapters.length}
        data-article
    />
</div>

<script
    id="chapters-data"
    type="application/json"
    set:html={JSON.stringify(chapters)}
></script>

<script>
    const backgrounds =
        document.querySelectorAll<HTMLElement>('[data-background]');

    const steps =
        document.querySelectorAll<HTMLElement>('[data-step]');

    const content =
        document.querySelector<HTMLElement>('#content');

    const portraitContent =
        document.querySelector<HTMLElement>('#portrait-content');

    const articleContent =
        document.querySelector<HTMLElement>('#article-content');

    const title =
        document.querySelector<HTMLElement>('#title');

    const text =
        document.querySelector<HTMLElement>('#text');

    const nextButton =
        document.querySelector<HTMLButtonElement>('#next');

    const nextLabel =
        document.querySelector<HTMLElement>('#next-label');

    const nextIcon =
        document.querySelector<HTMLElement>('#next-icon');

    const chaptersData =
        document.querySelector<HTMLScriptElement>('#chapters-data');

    const progressButtons =
        document.querySelectorAll<HTMLButtonElement>('[data-go-step]');

    const mobileProgress =
        document.querySelector<HTMLElement>('#mobile-progress');

    const chapters = JSON.parse(
        chaptersData?.textContent ?? '[]'
    );

    let currentStep = 0;

    const hideTimers = new WeakMap<HTMLElement, number>();

    function hideElement(element: HTMLElement | null) {
        if (!element) {
            return;
        }

        const previousTimer = hideTimers.get(element);

        if (previousTimer) {
            window.clearTimeout(previousTimer);
        }

        element?.classList.remove('opacity-100');

        element?.classList.add(
            'opacity-0',
            'translate-y-6'
        );

        const timer = window.setTimeout(() => {
            element.classList.remove('flex');
            element.classList.add('hidden');
            hideTimers.delete(element);
        }, 500);

        hideTimers.set(element, timer);
    }

    function showElement(element: HTMLElement | null) {
        if (!element) {
            return;
        }

        const pendingHide = hideTimers.get(element);

        if (pendingHide) {
            window.clearTimeout(pendingHide);
            hideTimers.delete(element);
        }

        element?.classList.remove('hidden');
        element?.classList.add('flex');

        requestAnimationFrame(() => {
            element?.classList.remove(
                'opacity-0',
                'translate-y-6'
            );

            element?.classList.add('opacity-100');
        });
    }

    function showStep(index: number) {
        currentStep = index;

        progressButtons.forEach((button, buttonIndex) => {
            const isActive = buttonIndex === index;

            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-current', isActive ? 'step' : 'false');
        });

        if (mobileProgress) {
            mobileProgress.textContent = `${String(index + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
        }

        const isArticle = index === chapters.length;
        const chapter = chapters[index];
        const isPortrait = chapter?.layout === 'portrait';

        const visibleBackgroundIndex = isArticle
            ? chapters.length - 1
            : index;

        backgrounds.forEach((background, backgroundIndex) => {
            const isVisible =
                backgroundIndex === visibleBackgroundIndex;

            background.classList.toggle(
                'opacity-100',
                isVisible
            );

            background.classList.toggle(
                'opacity-0',
                !isVisible
            );

            background.classList.toggle(
                'article-background',
                isArticle && isVisible
            );
        });

        if (isArticle) {
            content?.classList.add(
                'opacity-0',
                'translate-y-6'
            );

            hideElement(portraitContent);
            showElement(articleContent);

            if (nextLabel) {
                nextLabel.textContent = 'Zobacz ofertę';
            }

            if (nextIcon) {
                nextIcon.textContent = '→';
            }

            return;
        }

        hideElement(articleContent);

        if (isPortrait) {
            content?.classList.add(
                'opacity-0',
                'translate-y-6'
            );

            showElement(portraitContent);
        } else {
            hideElement(portraitContent);

            content?.classList.remove(
                'opacity-0',
                'translate-y-6'
            );

            if (title) {
                title.textContent = chapter?.title ?? '';
            }

            if (text) {
                text.textContent = chapter?.text ?? '';
            }
        }

        if (nextLabel) {
            nextLabel.textContent = 'Dalej';
        }

        if (nextIcon) {
            nextIcon.textContent = '↓';
        }
    }

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                    return;
                }

                const element =
                    entry.target as HTMLElement;

                showStep(
                    Number(element.dataset.step)
                );
            });
        },
        {
            threshold: 0.55,
        }
    );

    steps.forEach((step) => observer.observe(step));

    const scrollToStep = (index: number) => {
        steps[index]?.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
                ? 'auto'
                : 'smooth',
        });
    };

    progressButtons.forEach((button) => {
        button.addEventListener('click', () => {
            scrollToStep(Number(button.dataset.goStep));
        });
    });

    nextButton?.addEventListener('click', () => {
        if (currentStep === steps.length - 1) {
            window.location.href = '/#products';
            return;
        }

        scrollToStep(currentStep + 1);
    });

    window.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'PageDown') {
            event.preventDefault();
            scrollToStep(Math.min(currentStep + 1, steps.length - 1));
        }

        if (event.key === 'ArrowUp' || event.key === 'PageUp') {
            event.preventDefault();
            scrollToStep(Math.max(currentStep - 1, 0));
        }
    });

    const syncStepWithScroll = () => {
        let closestStep = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        steps.forEach((step, index) => {
            const distance = Math.abs(step.getBoundingClientRect().top);

            if (distance < closestDistance) {
                closestDistance = distance;
                closestStep = index;
            }
        });

        showStep(closestStep);
    };

    window.addEventListener('pageshow', () => {
        requestAnimationFrame(syncStepWithScroll);
    });

    showStep(0);
</script>

<style>
    :global(html) {
        scroll-snap-type: y mandatory;
    }

    [data-step] {
        scroll-snap-align: start;
        scroll-snap-stop: always;
    }

    .history-progress.is-active {
        color: rgb(252 211 77);
    }

    .history-progress.is-active .history-progress-number {
        opacity: 1;
    }

    .history-progress.is-active .history-progress-mark {
        height: 1.75rem;
        border-radius: 9999px;
    }

    .history-image {
        filter: brightness(0.9);
        animation: history-zoom 14s ease-out forwards;
    }

    .history-background {
        transition:
            opacity 1s ease,
            filter 0.8s ease;
    }

    .history-background.article-background {
        filter: blur(5px) brightness(0.6);
    }

    @keyframes history-zoom {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.06);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(html) {
            scroll-behavior: auto;
        }

        .history-image {
            animation: none;
        }

        .history-background,
        #content,
        #portrait-content,
        #article-content {
            transition-duration: 0.01ms;
        }
    }
</style>
