---
import { products } from '../data/products';
---

<section id="products" class="bg-stone-50 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-6">
        <div class="mb-10 max-w-2xl md:mb-16">
            <span class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-700">
                Nasza oferta
            </span>

            <h2 class="mt-3 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
                Nasze wypieki
            </h2>

            <p class="mt-4 text-lg leading-relaxed text-stone-600">
                Codziennie świeże pieczywo i tradycyjne wypieki przygotowywane na miejscu.
            </p>
        </div>

        <div class="grid gap-x-12 gap-y-10 md:grid-cols-3 md:gap-y-12">
            {
                products.map((category, index) => (
                    <div
                        class:list={[
                            'relative',
                            index !== 0 && 'md:border-l md:border-stone-200 md:pl-12',
                        ]}
                    >
                        <div class="mb-5 flex items-center gap-4 md:mb-7">
                            <span
                                class="
                                    flex h-10 w-10 shrink-0
                                    items-center justify-center
                                    rounded-full
                                    bg-amber-100
                                    text-lg font-bold
                                    text-amber-700
                                "
                            >
                                {String(index + 1).padStart(2, '0')}
                            </span>

                            <h3 class="text-2xl font-semibold text-stone-900">
                                {category.category}
                            </h3>
                        </div>

                        <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2 md:grid-cols-1">
                            {category.items.map((item) => (
                                <li class="flex items-start gap-3 text-stone-600">
                                    <span
                                        class="
                                                mt-[0.65rem] h-1.5 w-1.5
                                                shrink-0 rounded-full
                                                bg-amber-600
                                            "
                                    />

                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>
