---
import aboutImage from '../assets/images/about.jpg';
---

<section id="about" class="bg-stone-100 py-24">
    <div class="fade-in mx-auto grid max-w-7xl gap-12 px-6 md:grid-cols-2 md:items-center">
        <div>
            <img
                src={aboutImage.src}
                alt="Świeże pieczywo z piekarni Jedynka"
                class="rounded-3xl shadow-xl"
            />
        </div>

        <div>
            <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-amber-700">
                O naszej piekarni
            </p>

            <h2 class="mb-6 text-4xl font-bold text-stone-800">Tradycyjny smak każdego dnia</h2>

            <p class="mb-6 text-lg leading-relaxed text-stone-600">
                Piekarnia Jedynka w Spytkowicach to miejsce, w którym każdego dnia przygotowujemy
                świeże pieczywo oraz tradycyjne wypieki.
            </p>

            <p class="text-lg leading-relaxed text-stone-600">
                Dbamy o jakość naszych produktów i smak, który towarzyszy naszym klientom każdego
                dnia.
            </p>
        </div>
    </div>
</section>
