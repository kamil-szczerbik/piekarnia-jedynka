---
import main from '../assets/images/main.jpg';
---

<section class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <img
        src={main.src}
        alt="Piekarnia Jedynka"
        class="absolute inset-0 h-full w-full scale-[1.01] object-cover blur-[2px]"
    />

    <div class="absolute inset-0 bg-black/50"></div>

    <div class="relative z-10 max-w-4xl px-6 text-center text-white">
        <h1 class="mb-6 text-5xl font-bold text-amber-100 sm:text-6xl">Piekarnia JEDYNKA</h1>

        <p class="mx-auto mb-10 max-w-3xl text-xl leading-relaxed text-white/90">
            W Spytkowicach każdego dnia przygotowujemy świeże pieczywo oraz tradycyjne wypieki.
            Dbamy o jakość naszych produktów i smak, który towarzyszy naszym klientom każdego dnia.
        </p>

        <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <a
                href="#products"
                class="rounded-full border border-white/60 bg-white/10 px-8 py-4 text-lg font-semibold backdrop-blur-sm transition hover:border-white hover:bg-white/20"
            >
                Zobacz ofertę
            </a>

            <a
                href="#contact"
                class="rounded-full border border-white/60 bg-white/10 px-8 py-4 text-lg font-semibold backdrop-blur-sm transition hover:border-white hover:bg-white/20"
            >
                Znajdź najbliższy sklep
            </a>
        </div>
    </div>
</section>
