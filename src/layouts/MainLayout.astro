---
import '../styles/global.css';

interface Props {
    title?: string;
}

const { title = 'Piekarnia Jedynka' } = Astro.props;
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>

        <meta
            name="description"
            content="Piekarnia Jedynka - świeże pieczywo i wypieki każdego dnia."
        />
        <script>
            import '../scripts/animations';
        </script>
    </head>

    <body class="bg-stone-50 text-stone-800">
        <slot />
    </body>
</html>
